{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigBear",
  "version": "0.3.2",
  "identifier": "com.digbear.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "掘掘熊 · DigBear",
        "width": 1240,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "DigBear — website media crawler",
    "longDescription": "DigBear (掘掘熊) discovers images, videos, audio and fonts on any website, then saves selected media to a local folder.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "zh-CN",
          "en-US"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
